# 서버의 ~/fryday-prod/.env 로 복사해 채운다.
# 따옴표 없이 쓰되, FCM_CREDENTIALS_JSON 은 `jq -c . 파일.json` 결과를 작은따옴표로 감싼다.

DB_HOST=
DB_SCHEMA_PROD=
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

JWT_SECRET_KEY_PROD=
APPLE_CLIENT_ID=
FCM_ENABLED=true
FCM_CREDENTIALS_JSON='{"type":"service_account",...}'
DOCS_USER=
DOCS_PASSWORD=
ADMIN_API_KEY=
ADMIN_JWT_SECRET_KEY=
