# 서버의 deploy 디렉터리에 .env 로 복사해 채운다. compose 변수 치환과 앱 env_file 에 같이 쓰인다.
# 따옴표 없이 쓰되, FCM_CREDENTIALS_JSON 은 `jq -c . 파일.json` 결과를 작은따옴표로 감싼다.

MYSQL_ROOT_PASSWORD=
DB_SCHEMA_DEV=fryday_dev
DB_USERNAME=fryday
DB_PASSWORD=

REDIS_PASSWORD=

JWT_SECRET_KEY_DEV=
APPLE_CLIENT_ID=
FCM_ENABLED=true
FCM_CREDENTIALS_JSON='{"type":"service_account",...}'
DOCS_USER=
DOCS_PASSWORD=
ADMIN_API_KEY=
